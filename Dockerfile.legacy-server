FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    YOLO_CONFIG_DIR=/tmp/ultralytics \
    FLWR_DISABLE_UPDATE_CHECK=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      torch==2.2.2 torchvision==0.17.2 \
    && python3 -m pip install --no-cache-dir \
      "flwr==1.10.0" \
      "ultralytics>=8.3.0,<9.0" \
      "PyYAML>=6.0,<7.0"

COPY embeddedexample /app/embeddedexample

RUN mkdir -p /app/models /app/runs /tmp/matplotlib /tmp/ultralytics

EXPOSE 8080

ENTRYPOINT ["python3", "-m", "embeddedexample.legacy_server"]
